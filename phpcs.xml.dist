<?xml version="1.0"?>
<ruleset name="Divi 5 WooCommerce MCP">
	<description>WordPress coding standards for the plugin source.</description>

	<file>divi-5-woocommerce-mcp.php</file>
	<file>src</file>

	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>tests/*</exclude-pattern>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="WordPress-Extra"/>
</ruleset>
